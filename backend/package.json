{
  "name": "ioe2027-be",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend (Cloudflare Workers + D1 + R2) untuk website Indonesia Ocean Expo 2027",
  "scripts": {
    "dev": "wrangler dev --port 8000",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply ioe2027 --local",
    "db:migrate:remote": "wrangler d1 migrations apply ioe2027 --remote",
    "db:seed:local": "wrangler d1 execute ioe2027 --local --file=seed/seed.sql",
    "db:enable:testing": "wrangler d1 execute ioe2027 --remote --file=seed/testing-open-2026-11-04.sql",
    "db:admin:local": "node scripts/create-admin.mjs --local",
    "db:admin:remote": "node scripts/create-admin.mjs --remote"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "jose": "^6.2.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.12",
    "@cloudflare/workers-types": "^5.20261026.1",
    "typescript": "^5.9.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
