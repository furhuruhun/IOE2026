{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ioe2027-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ioe2027",
			"database_id": "9466ba23-36ca-464e-a284-fc1d55ba78d8",
			"migrations_dir": "migrations"
		},
		{
			"binding": "ioe2027",
			"database_name": "ioe2027",
			"database_id": "9466ba23-36ca-464e-a284-fc1d55ba78d8",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "FILES",
			"bucket_name": "ioe2027-files"
		},
		{
			"bucket_name": "ioe2027-files",
			"binding": "ioe2027_files",
			"remote": true
		}
	],
	"vars": {
		"JWT_TTL_SECONDS": "604800",
		"FILE_URL_TTL_SECONDS": "3600",
    "APP_TZ": "Asia/Jakarta"
	}
}
