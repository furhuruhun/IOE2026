# SEO stays non-indexable unless all three production settings are explicitly set
# after owner approval. These are server-only, build-time settings; rebuild to change.
# IOE_SITE_ENV=production
# IOE_PUBLIC_ORIGIN=<verified HTTPS origin, no path/query/credentials>
# IOE_ALLOW_INDEXING=1
# Defaults/preview: noindex, robots Disallow: /, empty sitemap, no canonical/og:url.
