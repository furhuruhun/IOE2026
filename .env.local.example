# Server-only — TIDAK boleh prefix NEXT_PUBLIC_, tidak boleh bocor ke client bundle.
# Semua call ke Workers dilakukan server-side lewat Next.js Route Handler proxy.
# Lihat amunisi/API_CONTRACT.md §Base URL per Environment.
WORKERS_API_URL=http://localhost:8000/api

# Client — dipakai tombol "Continue with Google" (GoogleAuthButton).
# ⚠️ Belum diterima dari klien — lihat amunisi/AUTH_IMPLEMENTATION.md §Awareness A2.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
